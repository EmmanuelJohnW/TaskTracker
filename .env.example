# Supabase project settings → API (or `npx supabase status` for the local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional (server-only): the app's public URL, e.g. https://tracker.vercel.app.
# Used to build email sign-in links; when unset, the request's Origin header is used.
# SITE_URL=http://localhost:3000
